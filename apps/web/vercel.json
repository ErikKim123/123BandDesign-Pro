{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "regions": ["hnd1"],
  "crons": [
    {
      "path": "/api/cron/heart-digest",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/kakaopay-health",
      "schedule": "0 1 * * *"
    }
  ]
}
