# 123Band OBS 브리지 설정 — 이 파일을 .env 로 복사한 뒤 값을 채웁니다.
# .env 는 절대 커밋하지 마세요.

# ── 123Band (Supabase) ────────────────────────────────────────
# 어드민 개발자에게 받으세요. anon 키는 공개 키라 이 노트북에 둬도 안전합니다.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR-ANON-KEY"

# 현장 토큰 — 어드민 › 라이브 방송관리 › 해당 방송 › '탈리 주소 복사' 의 t= 뒤 값입니다.
# 이 토큰은 그 방송 하나에만 쓰입니다. 방송이 바뀌면 토큰도 바꿔야 합니다.
BAND_FIELD_TOKEN=""

# ── OBS ────────────────────────────────────────────────────
# OBS 메뉴 › 도구 › obs-websocket 설정 에서 '웹소켓 서버 활성화' 를 켜고 포트/비밀번호를 확인하세요.
OBS_URL="ws://127.0.0.1:4455"
OBS_PASSWORD=""

# ── 선택 ───────────────────────────────────────────────────
# 지시를 확인하는 주기(밀리초). 기본 1000 = 1초.
POLL_MS="1000"
# 카메라 신호 상태를 확인하는 주기(밀리초). 기본 10000 = 10초.
HEALTH_MS="10000"
