# Design Ref: §10.3 — 환경변수 규약 (NEXT_PUBLIC_*=브라우저, 나머지=서버 전용)
# 실제 값은 .env 에 넣고 git 에 커밋하지 말 것 (.gitignore 처리됨)

# NOTE: 앱별 NEXT_PUBLIC_* 는 각 앱의 .env.local 에 둔다 (apps/web/.env.local, apps/admin/.env.local).
#       이 루트 .env 는 DB 검증/결제 등 모노레포 공용 서버 키 용도.

# --- Supabase (클라이언트 접근 가능 — 각 앱 .env.local 에도 필요) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"
# 배포 도메인 (apps/web 의 sitemap/OG 기준)
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# --- Supabase (서버 전용, RLS 우회 — 절대 NEXT_PUBLIC_ 금지) ---
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"
SUPABASE_DB_PASSWORD="YOUR-DB-PASSWORD"

SUPABASE_DB_POOLER_HOST=aws-1-ap-northeast-1.pooler.supabase.com

# --- 소셜/전화 로그인 (앱 env 불필요 — Supabase 대시보드에서 설정) ---
# 구글(OAuth): Supabase Dashboard > Authentication > Providers > Google 활성화.
#   - Google Cloud Console > OAuth 2.0 클라이언트 ID/시크릿 입력, 승인된 리디렉션 URI 에
#     https://YOUR-PROJECT.supabase.co/auth/v1/callback 등록.
# 카카오톡(OAuth): Supabase Dashboard > Authentication > Providers > Kakao 활성화.
#   - Kakao Developers 앱의 REST API 키/시크릿 입력, Redirect URI 에
#     https://YOUR-PROJECT.supabase.co/auth/v1/callback 등록.
#   - Supabase > Auth > URL Configuration > Redirect URLs 에
#     http://localhost:3000/**, https://your-domain.com/** 허용.
# WhatsApp(전화 OTP): Supabase Dashboard > Authentication > Providers > Phone 활성화.
#   - SMS provider = Twilio, Message channel 에서 WhatsApp 활성화(Twilio WhatsApp Sender 필요).
#   - 앱 코드는 signInWithOtp({ phone, options: { channel: 'whatsapp' } }) 로 호출.

# --- DB 직접 연결 (Runtime 검증 db:verify 용, postgres 직접 연결) ---
# Supabase: Settings > Database > Connection string > URI
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# --- 라이브 방송 (유튜브 채팅 임베드) — 선택 ---
# 유튜브 라이브 채팅 iframe 은 부모 도메인을 정확히 알아야 렌더된다(불일치 = 빈 채팅창).
# 평소에는 설정하지 않아도 된다 — 브라우저가 보고 있는 주소(window.location.hostname)를 그대로 쓴다.
# 프록시·커스텀 도메인처럼 접속 호스트와 부모 도메인이 다른 예외 상황에서만 덮어쓴다.
# NEXT_PUBLIC_EMBED_DOMAIN="www.worldoflatinfestivals.com"

# --- AI 상품페이지 생성 (Phase 3) ---
# 실제 사용 위치는 apps/admin/.env.local (admin 의 /api/ai/* route handler). 서버 전용, 노출 금지.
ANTHROPIC_API_KEY=""

# --- 결제 (Phase 4, PayVerse(이롬넷) 단일 PG, 전부 서버 전용) ---
# 사용 위치는 apps/web/.env.local(결제 요청·확정) + apps/admin/.env.local(주문 환불).
# 어드민 '환불' 버튼이 PayVerse 취소 API 를 호출하므로 admin 에도 같은 값이 있어야 한다.
# clientKey 는 결제창 호출용으로 브라우저에 전달되지만
# 서버(/api/payments/checkout)가 내려주므로 NEXT_PUBLIC_ 접두사는 쓰지 않는다.
# secretKey 는 위변조 서명(sign) 생성 전용 — 절대 브라우저로 내보내지 않는다.
#
# sandbox = 테스트 결제창(ui-snd/pay-snd), live = 운영. 미지정 시 sandbox.
PAYVERSE_ENV="sandbox"
# 가맹점관리자(https://merchant-snd.payverseglobal.com/) > 연동정보에서 확인
# 한글(KRW) 가맹점
PAYVERSE_MID_KRW=""
PAYVERSE_CLIENT_KEY_KRW=""
PAYVERSE_SECRET_KEY_KRW=""
# 영문(USD) 가맹점
PAYVERSE_MID_USD=""
PAYVERSE_CLIENT_KEY_USD=""
PAYVERSE_SECRET_KEY_USD=""

# --- 인스타그램 연동 (apps/admin, 서버 전용) ---
# 액세스 토큰 자체는 어드민 › 설정 화면에서 입력해 DB(app_settings)에 저장된다. 여기엔 넣지 않는다.
# 아래 두 값은 짧은 수명 토큰을 60일 장기 토큰으로 교환하고 만료 전 자동 갱신하는 데 쓴다.
# 없으면 토큰이 만료될 때마다 수동으로 재발급해야 한다.
# 발급: developers.facebook.com > 내 앱 > 설정 > 기본 설정 > 앱 ID / app secret
META_APP_ID=""
META_APP_SECRET=""
# 예약 게시·토큰 갱신 cron 보호용 공용 시크릿(뉴스레터 cron 과 동일 값 사용).
CRON_SECRET=""

# Brevo (참가자 등록 확인 메일) — 코드는 Brevo 사용. (구 Resend 키는 미사용)
BREVO_API_KEY="YOUR-BREVO-API-KEY"
# Brevo Senders 에서 검증 완료된 발신 주소.
BREVO_FROM_EMAIL=bandnara123@gmail.com
BREVO_FROM_NAME=JNJ JOIN
# 운영자 알림 수신자(송금 완료·신규 가입·승인요청·결제완료·후기·문의·쿠폰발급).
# 쉼표로 여러 명 지정 가능. 미설정 시 bandnara123@gmail.com 한 명에게만 발송된다.
ADMIN_NOTIFY_EMAIL=bandnara123@gmail.com,latinnoble80@gmail.com
# 알림 메일 본문의 "확인하기" 버튼이 가리킬 어드민 주소. 비우면 버튼을 붙이지 않는다.
ADMIN_BASE_URL="https://123band-admin.vercel.app"
# 쿠폰 발급(스탬프 카드 완성·포인트 교환) 알림 웹훅의 공유 시크릿.
# DB 트리거(0064)가 이 값을 x-notify-secret 헤더로 보내고 /api/notify/coupon 이 대조한다.
# DB 쪽 값과 반드시 같아야 한다 — 설정: node packages/supabase/apply_notify_webhook.mjs <url> <secret>
# 비어 있으면 수신 라우트가 전부 403 으로 막는다(알림만 안 가고 발급은 정상).
NOTIFY_WEBHOOK_SECRET=""

# 웹푸시(VAPID) — 소셜 하트 알림. `node scripts/gen-vapid.mjs` 로 생성한 값을 넣는다.
# 공개키는 브라우저 구독에도 쓰이므로 NEXT_PUBLIC_ 접두사가 필요하다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# 푸시 서비스가 문제 발생 시 연락할 주소 (mailto: 또는 https:)
VAPID_SUBJECT=mailto:bandnara123@gmail.com


